#!/bin/sh
set -eu
# A milestone names the current step in the card's words. The public dashboard shows it, so it keeps to the characters that src/observability.ts allows, and those need no JSON escaping.
if [ "$#" -eq 2 ] && [ "$1" = milestone ]; then
    case "$2" in
        *[!A-Za-z0-9\ ,.\'-]*) printf '%s\n' "A milestone uses only letters, digits, spaces and , . ' -" >&2; exit 2 ;;
    esac
    if [ "${#2}" -lt 3 ] || [ "${#2}" -gt 80 ]; then printf '%s\n' 'A milestone is 3 to 80 characters long' >&2; exit 2; fi
    printf '{"type":"factory_status","milestone":"%s"}\n' "$2"
    exit 0
fi
if [ "$#" -ne 1 ]; then
    printf '%s\n' 'Usage: factory-status <activity> | factory-status milestone <milestone>' >&2
    exit 2
fi
case "$1" in
    reading|editing|tests|typecheck|playtest|build|publish|install|git|review|design|investigate|waiting)
        printf '{"type":"factory_status","activity":"%s"}\n' "$1"
        ;;
    *) printf '%s\n' 'Unknown activity' >&2; exit 2 ;;
esac
