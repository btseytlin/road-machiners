#!/bin/bash
# Links the game's project skills from /work/game/.agents/skills into the ephemeral container home, then runs claude.
# Claude Code loads user skills from ~/.claude/skills and does not discover .agents/skills.
# The image ships the Blender image skill in ~/.claude/skills. A run without it would model from a reference blind, so it stops.
set -euo pipefail

src=${FACTORY_GAME_SKILLS:-/work/game/.agents/skills}
if [ ! -d "$src" ]; then
  echo "factory-agent: $src is missing" >&2
  exit 1
fi

mkdir -p "$HOME/.claude/skills"
if [ ! -f "$HOME/.claude/skills/blender-image-to-3d/SKILL.md" ]; then
  echo "factory-agent: the blender-image-to-3d skill is missing from $HOME/.claude/skills" >&2
  exit 1
fi
for dir in "$src"/*/; do
  if [ -f "${dir}SKILL.md" ] && [ ! -e "$HOME/.claude/skills/$(basename "$dir")" ]; then
    ln -s "${dir%/}" "$HOME/.claude/skills/$(basename "$dir")"
  fi
done

exec claude --append-system-prompt 'When your purpose changes, run factory-status with one category: reading, editing, tests, typecheck, playtest, build, review, design, investigate, or waiting. At each meaningful work milestone, run factory-status milestone with one of: understanding, planning, implementing, validating, reviewing, preparing-release. Do not include notes, commands, prompts, or private task text. Report only when the milestone changes, without extra narration.' "$@"
