# Copy to dashboard/.env. The dashboard also reads factory/settings.env and factory/.env.
# For production, set the socket and leave the port blank. Caddy uses this socket.
DASHBOARD_SOCKET=
DASHBOARD_PORT=8787
DASHBOARD_REFRESH_MS=2000
DASHBOARD_GITHUB_REFRESH_MS=60000
DASHBOARD_COMMAND_TIMEOUT_MS=15000
# Set a public channel URL and keep DASHBOARD_HIDE_TELEGRAM empty, or set DASHBOARD_HIDE_TELEGRAM=1 and leave the URL empty to withhold Telegram posts.
DASHBOARD_CHANNEL_URL=https://t.me/your_public_channel
DASHBOARD_HIDE_TELEGRAM=
