# Copy to prod.env (gitignored) and fill in. Run pyinfra from factory/infra.

# Server address or DNS name.
FACTORY_HOST=
# SSH login. Deploy uses sudo, so a non-root user needs passwordless sudo.
FACTORY_SSH_USER=root
# Path to the private key for that login. Leave empty to use the ssh agent.
FACTORY_SSH_KEY=
# Public domain. Its DNS lives in Cloudflare, and the tunnel routes it to Caddy.
FACTORY_DOMAIN=
# Token of the Cloudflare Tunnel, from the dashboard's install command for Docker.
FACTORY_TUNNEL_TOKEN=
# Local path of the factory .env that deploy pushes. It must set FACTORY_HOME=/opt/factory/home and FACTORY_WEB_ROOT=/opt/factory/www.
FACTORY_ENV_FILE=
# Classic GitHub token of the bot account, with repo and project scopes. Deploy writes it into the server's factory env as GH_TOKEN.
FACTORY_GH_TOKEN=
# Optional. Deploy does not read it. A Cloudflare API token scoped to this domain, for changing the tunnel routes and DNS by hand or by script.
# It needs Account Cloudflare Tunnel Edit, and Zone DNS Edit, Zone Settings Edit, Zone Cache Rules Edit and Zone Read on the domain. Give it an end date.
CLOUDFLARE_API_TOKEN=
