(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# The Cloudflare Tunnel is the only way in. Cloudflare serves HTTPS to players and passes plain HTTP to Caddy, so Caddy gets no certificates.

# The web root holds /dev/ and one folder per build hash. Folder requests serve index.html.
# The bare domain sends players to the released game on itch.io. The builds stay under their paths.
http://{$DOMAIN} {
	import security_headers
	redir / {$ITCH_URL} temporary
	handle /factory* {
		reverse_proxy unix//opt/factory/dashboard/http.sock
	}
	# Game builds post error reports here. The tunnel's CF-Connecting-IP header passes through to the service.
	handle /errors {
		reverse_proxy unix//opt/factory/errors/http.sock
	}
	root * /srv/www
	file_server {
		index index.html
	}
}

# www sends every request to the bare domain, keeping the path.
http://www.{$DOMAIN} {
	import security_headers
	redir https://{$DOMAIN}{uri} permanent
}
