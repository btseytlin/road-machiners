// Testing column. One testing session gets a card ready for the committee, and the post checkpoint gates the post. Post-only runs when Hermes moves a card to Approval.
// Red: loops back. Grey: leaves Testing or enters from outside.
digraph testing {
  rankdir=LR; nodesep=0.35; ranksep=0.55; bgcolor=white; pad=0.3;
  node [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=13, margin="0.2,0.1", penwidth=1.3, width=1.3];
  edge [color="#374151", penwidth=1.8, arrowsize=0.8, fontname="Helvetica", fontsize=11];
  subgraph cluster_session {
    label="Testing job"; fontname="Helvetica"; fontsize=12; color="#c7d2fe"; style=rounded;
    PM [label="Merge new branch\ncommits and the base"]; PT [label="Testing session\nplay, fix, capture,\nwrite the post"];
    PC [label="Post checkpoint\ntypecheck, playtest, build"]; PP [label="Post to\ncommittee", fillcolor="#fde68a", color="#b45309"];
    PM -> PT -> PC -> PP [weight=100];
  }
  subgraph cluster_post {
    label="Post: moved by Hermes"; fontname="Helvetica"; fontsize=12; color="#c7d2fe"; style=rounded;
    QB [label="Build only\nno tests, no playtest"]; QP [label="Post to committee\nno checks ran", fillcolor="#fde68a", color="#b45309"];
    QB -> QP [weight=100];
  }
  XH [label="Hermes\nmove to Approval", fillcolor="#f3f4f6", color="#6b7280"];
  XA [label="Approval\npatch reply", fillcolor="#f3f4f6", color="#6b7280"];
  XD [label="Design", fillcolor="#f3f4f6", color="#6b7280"];
  XS [label="factory-stuck", fillcolor="#f3f4f6", color="#6b7280"];
  edge [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.3];
  PC -> PT [label="failure: back into\nthe same session"];
  PC -> PC [label="timeouts: rerun, up to 3"];
  edge [color="#6b7280", fontcolor="#6b7280"];
  PM -> PC [label="docs only: no session,\nthe checkpoint only builds"];
  XH -> QB;
  XA -> PM [label="the reply is the task"];
  PT -> XD [label="plan wrong"];
  PC -> XS [label="budget spent"];
}
