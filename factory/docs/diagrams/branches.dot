// Branches. Each arrow is a merge. Grey: a pull request a member merges.
digraph branches {
  rankdir=LR; nodesep=0.35; ranksep=0.8; bgcolor=white; pad=0.3;
  node [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=13, margin="0.2,0.1", penwidth=1.3, width=1.4];
  edge [color="#374151", penwidth=1.6, arrowsize=0.8, fontname="Helvetica", fontsize=11];
  issue [label="factory/issue-N"]; dev [label="dev", fillcolor="#c7d2fe"]; rel [label="release/day", fillcolor="#c7d2fe"]; main [label="main", fillcolor="#c7d2fe"];
  task [label="factory/issue-N\nrelease task"]; hotfix [label="factory/issue-N\nhotfix, from main"]; chg [label="factory-change/id\nfrom main"];
  issue -> dev [label="merge queue"]; dev -> rel [label="release cut"]; rel -> main [label="ship"];
  task -> rel [label="merge queue"]; hotfix -> main [label="hotfix approve"];
  edge [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.3];
  main -> dev [label="after ship or hotfix", constraint=false];
  dev -> issue [label="before design, testing\nor hardening", constraint=false];
  edge [color="#6b7280", fontcolor="#6b7280"];
  chg -> main [label="member merges PR"];
}
