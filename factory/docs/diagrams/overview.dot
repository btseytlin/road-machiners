// Overview. Black: normal path. Red: loops back. Yellow: waits for people.
digraph overview {
  rankdir=LR; nodesep=0.3; ranksep=0.6; bgcolor=white; pad=0.3;
  node [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=13, margin="0.2,0.1", penwidth=1.3, width=1.3];
  edge [color="#374151", penwidth=1.8, arrowsize=0.8, fontname="Helvetica", fontsize=11];
  U [label="Public files\nand votes", fillcolor="#fde68a", color="#b45309"];
  B [label="Agents build\nTriage to Testing"];
  C [label="Committee plays\nand approves", fillcolor="#fde68a", color="#b45309"];
  V [label="dev"];
  R [label="Release\ncandidate"];
  S [label="Committee\nships", fillcolor="#fde68a", color="#b45309"];
  O [label="main\nand itch.io"];
  E [label="Game error\nreports"];
  U -> B -> C -> V -> R -> S -> O [weight=100];
  E -> B [weight=0];
  edge [color="#dc2626", fontcolor="#dc2626", style=dashed, penwidth=1.3, dir=back, weight=0];
  B -> C [label="feedback"];
  B -> S [label="remove or new task"];
}
