// One tick. Black: normal path. Grey: the tick stops early.
digraph tick {
  rankdir=LR; nodesep=0.3; ranksep=0.5; bgcolor=white; pad=0.3;
  node [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=13, margin="0.15,0.1", penwidth=1.3, width=1.1];
  edge [color="#374151", penwidth=1.8, arrowsize=0.8, fontname="Helvetica", fontsize=11];
  H [label="Write\nhealth file"]; Q [label="Paused?", shape=diamond, style=filled, width=1.1]; IN [label="Run inbox\ncommands"];
  J [label="Check jobs\nkill or resume"]; K [label="Intake"]; CL [label="Clean builds,\nclones, logs"];
  DSK [label="Disk ok?", shape=diamond, style=filled, width=1.1]; PK [label="Pick jobs\nby priority,\nChecks first"]; ST [label="Start each job\nthat fits,\none heavy at a time"];
  STOP [label="Skip the rest", fillcolor="#f3f4f6", color="#6b7280"];
  H -> Q -> IN -> J -> K -> CL -> DSK -> PK -> ST [weight=100];
  edge [color="#6b7280", fontcolor="#6b7280", style=dashed, penwidth=1.3, weight=0];
  Q -> STOP [label="yes"]; DSK -> STOP [label="no"];
}
